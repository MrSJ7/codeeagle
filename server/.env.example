# CodeLens Backend Server Environment Configuration
#
# Server Port (Render automatically sets PORT in production)
PORT=5001

# Application Environment Mode ('development' | 'production')
NODE_ENV=development

# Allowed Frontend Origins for CORS
# In production on Render: Set this to your deployed Vercel domain (e.g., https://codelens.vercel.app)
# In development: Localhost (http://localhost:5173) is automatically supported.
FRONTEND_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Google Gemini API Configuration (Optional Semantic Review Engine)
# Static AST analysis operates completely independently without an API key.
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# MongoDB Atlas Persistence Configuration (Optional)
# The application automatically falls back to in-memory persistence if MONGODB_URI is omitted or unreachable.
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/codelens?retryWrites=true&w=majority
# MONGODB_URI=mongodb://127.0.0.1:27017/codelens
