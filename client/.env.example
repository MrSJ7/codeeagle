# CodeLens Client Environment Configuration
#
# Base URL for the CodeLens Express API backend.
# In development: defaults to http://localhost:5001
# In production on Vercel: set this to your Render service URL (e.g., https://codelens-api.onrender.com)
#
# IMPORTANT: Never place secret credentials (e.g. GEMINI_API_KEY, MONGODB_URI) in client environment variables!
VITE_API_BASE_URL=http://localhost:5001
